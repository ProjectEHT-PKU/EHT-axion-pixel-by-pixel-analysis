# Copy once to .env.raptor if absent; build/generate scripts load this automatically.
# Generation reads .env shared paths, then this file; analysis never reads this file.
# CLI > exported environment > .env.raptor > .env. Values are data, not shell.
# Relative paths use this repository root; do not use $VARIABLE or $(commands).

EHT_PRODUCTION_CONFIG=configs/production.yaml
EHT_RAPTOR_SOURCE_ROOT=../raptor
EHT_GRMHD_ROOT=/home/canoziia/GRMHD_DATA/a094-high
EHT_RADIAL_LOW=../radial-function/reference/result_a=0.9375_l1m1.txt
EHT_RADIAL_HIGH=../radial-function/reference/result_a=0.99_l1m1.txt
EHT_RUN_ID=benchmark-211-m65
EHT_RAPTOR_THREADS=2
# EHT_RAPTOR_TIMEOUT_SECONDS=1800
# Optional absolute/relative root instead of EHT_OUTPUT_ROOT/production/EHT_RUN_ID:
# EHT_PRODUCTION_ROOT=../eht-pipeline-runs/production/benchmark-211-m65
