# Machine-local locations and execution settings of raptor_build.py and raptor_generate.py.
# Copy to .env.raptor and replace the placeholder paths. Scientific values come from
# configs/experiment.yaml (--config overrides the file path). The analysis never reads this file.
# CLI > exported environment > .env.raptor > .env. Values are data, not shell.
# Relative paths use this repository root; do not use $VARIABLE or $(commands).

EHT_RAPTOR_SOURCE_ROOT=/path/to/raptor
EHT_RAPTOR_RUN_ROOT=/path/to/m87-axion/raptor/run
EHT_GRMHD_ROOT=/path/to/bhac-snapshots
EHT_RADIAL_LOW=/path/to/radial-table-low.csv
EHT_RADIAL_HIGH=/path/to/radial-table-high.csv
EHT_RAPTOR_THREADS=2
EHT_RAPTOR_WORKERS=1
EHT_RAPTOR_CPU_AFFINITY=physical
# EHT_RAPTOR_CPU_LIST=0-47
# EHT_RAPTOR_TIMEOUT_SECONDS=1800
