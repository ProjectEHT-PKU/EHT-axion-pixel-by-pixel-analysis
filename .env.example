# Copy once to .env if it does not exist. Analysis scripts read it automatically.
# No export/source step; dotenv data is parsed, never executed as shell code.
# Relative file paths use this repository root; quote paths containing spaces.
# Priority: CLI > exported environment > dotenv. No variable/command expansion.

EHT_CONFIG=configs/research.yaml
EHT_INPUT_ROOT=data/inputs
EHT_OUTPUT_ROOT=../eht-pipeline-runs

# Only enable for the scientific pickle inputs supplied by trusted collaborators.
EHT_TRUST_PICKLE=false

# Safe defaults: never overwrite/rebuild or accept imported stages implicitly.
EHT_REBUILD=false
EHT_REUSE_IMPORTED=false

# To analyze generated data, set this explicitly (keep EHT_INPUT_ROOT for EHT):
# EHT_RAPTOR_INPUT_ROOT=../eht-pipeline-runs/production/benchmark-211-m65/data
# RAPTOR generation settings belong in .env.raptor (see .env.raptor.example).
