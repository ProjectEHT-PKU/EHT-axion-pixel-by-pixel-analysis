# Copy to .env, review these values, then export them in your shell:
#   cp .env.example .env
#   set -a
#   source .env
#   set +a
# Run from the repository root. Paths may be absolute; quote paths containing spaces.
# Command-line arguments override these variables; Python never auto-executes .env.

EHT_CONFIG=configs/research.yaml
EHT_INPUT_ROOT=data/inputs
EHT_OUTPUT_ROOT=../eht-pipeline-runs

# Only enable for the scientific pickle inputs supplied by trusted collaborators.
EHT_TRUST_PICKLE=false

# Safe defaults: never overwrite/rebuild or accept imported stages implicitly.
EHT_REBUILD=false
EHT_REUSE_IMPORTED=false

# Optional RAPTOR producer (explicit commands only; default pipeline never launches it).
# Use a fresh run ID for a new science configuration. CLI overrides these paths.
EHT_PRODUCTION_CONFIG=configs/production.yaml
EHT_RAPTOR_SOURCE_ROOT=../raptor
EHT_GRMHD_ROOT=/home/canoziia/GRMHD_DATA/a094-high
EHT_RADIAL_LOW=../radial-function/reference/result_a=0.9375_l1m1.txt
EHT_RADIAL_HIGH=../radial-function/reference/result_a=0.99_l1m1.txt
EHT_RUN_ID=benchmark-211
EHT_RAPTOR_THREADS=2
# EHT_PRODUCTION_ROOT=../eht-pipeline-runs/production/benchmark-211
# For analysis of generated data only (keep EHT_INPUT_ROOT for EHT observations):
# EHT_RAPTOR_INPUT_ROOT=../eht-pipeline-runs/production/benchmark-211/data
