# Machine-local roots and execution settings. Copy to .env and replace the placeholder paths.
# Scientific values live in configs/experiment.yaml.
# Values are parsed as dotenv data, never executed as shell code; do not use $VARIABLE or $(commands).
# Priority: CLI > exported environment > .env. Relative paths use this repository root.

# Local Git checkout of the RAPTOR repository pinned by raptor.source in configs/experiment.yaml
# (scripts/raptor/build.py, scripts/raptor/generate.py, scripts/analysis/paper.py: --source-root).
EHT_RAPTOR_SOURCE_ROOT=/path/to/raptor

# Read-only external inputs (docs/en/data-layout.md#input-layout): grmhd/data<label>.dat,
# radial/<tables>, eht/<uvfits>, eht/eht-imaging_pipeline.py.
# Explicit options (--fluid-root, --radial-low, --uvfits-dir, ...) override single entries.
EHT_INPUT_ROOT=/path/to/m87-axion-inputs

# Generated products (docs/en/data-layout.md#default-layout); every script derives its default
# input and output directories from it. Explicit --...-root options override the defaults.
EHT_DATA_ROOT=/path/to/m87-axion

# Optional execution settings of scripts/raptor/generate.py.
EHT_RAPTOR_THREADS=2
EHT_RAPTOR_WORKERS=1
EHT_RAPTOR_CPU_AFFINITY=physical
# EHT_RAPTOR_CPU_LIST=0-47
# EHT_RAPTOR_TIMEOUT_SECONDS=1800
