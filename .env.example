# Machine-local locations. Copy to .env and replace the placeholder paths.
# Scientific values live in experiment.yaml.
# Values are parsed as dotenv data, never executed as shell code.
# Priority: CLI > exported environment > dotenv. Relative paths use this repository root.

# Data root of the default layout (docs/en/data-layout.md); every script derives its default
# input and output roots from it. Explicit --...-root options override the defaults.
M87_AXION_DATA_ROOT=/path/to/m87-axion

# Official EHT 2017 M87* inputs for eht_reconstruct.py. The uvfits file names and sha256 are in experiment.yaml
# (eht_imaging.inputs).
EHT_IMAGING_INPUT_ROOT=/path/to/eht-2017-m87-uvfits
EHT_IMAGING_INPUT_RECEIPT=/path/to/eht-2017-m87-uvfits/input-receipt.json
EHT_IMAGING_FEED_ROTATION=/path/to/eht-2017-m87-uvfits/feed-rotation.json
EHT_IMAGING_OFFICIAL_SCRIPT=/path/to/eht-imaging_pipeline.py
