# Machine-local locations read by eht_reconstruct.py (and shared with the RAPTOR scripts).
# Copy to .env and replace the placeholder paths. Scientific values live in experiment.yaml;
# the other scripts take explicit --...-root options.
# Values are parsed as dotenv data, never executed as shell code.
# Priority: CLI > exported environment > dotenv. Relative paths use this repository root.

# Official EHT 2017 M87* inputs. The uvfits file names and sha256 are in experiment.yaml
# (eht_imaging.inputs).
EHT_IMAGING_INPUT_ROOT=/path/to/eht-2017-m87-uvfits
EHT_IMAGING_INPUT_RECEIPT=/path/to/eht-2017-m87-uvfits/input-receipt.json
EHT_IMAGING_FEED_ROTATION=/path/to/eht-2017-m87-uvfits/feed-rotation.json
EHT_IMAGING_OFFICIAL_SCRIPT=/path/to/eht-imaging_pipeline.py
