# Machine-local locations, read by the RAPTOR and eht-imaging scripts.
# Copy once to .env. Scientific values live in experiment.yaml;
# the analysis scripts take explicit --...-root options instead.
# Values are parsed as dotenv data, never executed as shell code.
# Priority: CLI > exported environment > dotenv. Relative paths use this repository root.

# Default container for RAPTOR runs when EHT_PRODUCTION_ROOT is not set.
EHT_OUTPUT_ROOT=../eht-pipeline-runs

# Official EHT 2017 M87* inputs for scripts/eht_reconstruct.py.
# The uvfits file names and sha256 are part of experiment.yaml (eht_imaging.inputs).
EHT_IMAGING_INPUT_ROOT=/home/canoziia/GRMHD_DATA/EHT_DATA/official-2023-D01-01
EHT_IMAGING_INPUT_RECEIPT=/home/canoziia/GRMHD_DATA/EHT_DATA/official-2023-D01-01/four-day-inputs-verified.json
EHT_IMAGING_FEED_ROTATION=/home/canoziia/GRMHD_DATA/EHT_DATA/official-2023-D01-01/reference/feed-rotation.json
EHT_IMAGING_OFFICIAL_SCRIPT=/home/canoziia/GRMHD_DATA/EHT_DATA/official-2019-D01-02/eht-imaging_pipeline.py
